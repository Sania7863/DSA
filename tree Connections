TREES (LEARNED HOE TO CREATE NODES AND JUST LIKE LINKED LIST CONNECT NODES)Given the root of a binary tree and two integers val and depth, add a row of nodes with value val at the given depth depth.

Note that the root node is at depth 1./**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode addOneRow(TreeNode root, int val, int depth) {
        if(depth==1){
            TreeNode vall=new TreeNode(val);
            vall.left=root;
            return vall;
        }
        helper(root,val,depth-1,1);
        return root;
        
        
    }
    public void helper(TreeNode root,int val,int depth,int count){
        if(root==null){
            return;
        }
        if(count==depth){
            TreeNode ol=root.left;
            TreeNode or=root.right;
            TreeNode gl=new TreeNode(val);
            TreeNode gr=new TreeNode(val);
            root.left=gl;
            root.right=gr;
            gl.left=ol;
            gr.right=or;
            
        }
        helper(root.left,val,depth,count+1);
        helper(root.right,val,depth,count+1);
    }
}
