class Solution {
    // Function to find the minimum number of swaps required to sort the array.
    public int minSwaps(int arr[]) {
        // Code here
        Map<Integer,Integer> mp=new HashMap<>();
        for(int i=0;i<arr.length;i++){
            mp.put(arr[i],i);
        }
        int[] lrr=arr.clone();
        int c=0;
        Arrays.sort(lrr);
        for(int i=0;i<arr.length;i++){
            if(arr[i]==lrr[i]) continue;
            c++;
            int correct=lrr[i];
            int ind=mp.get(correct);
            mp.put(correct,i);
            mp.put(arr[i],ind);
            int temp=arr[i];
            arr[i]=arr[ind];
            arr[ind]=temp;
            
            
        }
        return c;
    }
}
